---
import Header from "../components/Header.astro";
import CustomHead from "../layouts/CustomHead.astro";
---

<CustomHead title="DETECT.js - Eye Tracker">
  <Header />

  <!-- Outer container with clean white border -->
  <div
    class="bg-base-200 m-4 overflow-hidden flex flex-col items-center justify-between
           border-white rounded-lg border-4 opacity-90 shadow-glow min-h-[82vh] relative"
  >
    <!-- Row container for webcam canvas (left) and graph canvas (right) -->
    <div class="flex flex-col md:flex-row w-full h-auto justify-center items-center p-2 md:p-4 gap-4 flex-grow">
      <!-- Left side: Webcam -->
      <div class="flex flex-col justify-center items-center w-full md:w-1/2 p-2">
        <video id="webcamVideo" class="hidden" playsinline muted></video>
        <canvas
          id="webcamCanvas"
          class="rounded bg-neutral shadow-glow w-full h-[50vh] md:h-[58vh] object-contain"
        ></canvas>
      </div>

      <!-- Right side: Graph -->
      <div class="flex flex-col justify-center items-center w-full md:w-1/2 p-2">
        <canvas
          id="graphCanvas"
          class="border-2 border-white rounded-lg bg-black/60 w-full h-[50vh] md:h-[58vh]"
        ></canvas>
      </div>
    </div>

    <!-- Live Telemetry Status Bar -->
    <div class="w-full px-4 py-2 bg-base-300 border-t border-b border-white/20 flex flex-wrap justify-around items-center text-sm font-mono font-semibold text-white">
      <div>Gaze Position: <span id="mGaze" class="text-white font-bold">-- , --</span></div>
      <div>Quadrant: <span id="mQuad" class="text-accent font-bold">--</span></div>
      <div>Status: <span id="mStatus" class="text-warning font-bold">Uncalibrated</span></div>
    </div>

    <!-- Control buttons at the bottom -->
    <div class="flex flex-wrap md:flex-nowrap w-full font-semibold text-lg text-primary-content p-2 gap-2">
      <button
        id="btnStart"
        class="bg-info py-4 px-6 rounded-md flex-1 text-info-content
               hover:bg-success hover:text-success-content hover:scale-105
               hover:shadow-glow transition-transform cursor-pointer"
      >
        Start
      </button>
      <button
        id="btnCalibrate"
        disabled
        class="bg-secondary py-4 px-6 rounded-md flex-1 text-secondary-content
               hover:bg-primary hover:text-primary-content hover:scale-105
               hover:shadow-glow transition-transform cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
      >
        Calibrate (9-Point)
      </button>
      <button
        id="btnSaveXml"
        disabled
        class="bg-neutral py-4 px-6 rounded-md flex-1 text-neutral-content border border-white
               hover:bg-accent hover:text-accent-content hover:scale-105
               hover:shadow-glow transition-transform cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
      >
        Save XML
      </button>
    </div>
  </div>

  <!-- Fullscreen 9-Point Calibration Overlay -->
  <div id="calibOverlay" class="fixed inset-0 bg-base-100/95 z-50 hidden">
    <div id="targetPoint" class="absolute w-8 h-8 -ml-4 -mt-4 rounded-full bg-error border-2 border-white shadow-glow-magenta"></div>
    <div class="absolute bottom-10 left-0 right-0 text-center">
      <p id="calibText" class="text-2xl font-bold font-mono text-white">Look directly at the red dot...</p>
    </div>
  </div>

  <script>
    import { GazeTrackerEngine, SCREEN_TARGETS } from '../scripts/gazeEngine';

    let engine: GazeTrackerEngine | null = null;
    let video: HTMLVideoElement;
    let webcamCanvas: HTMLCanvasElement;
    let webcamCtx: CanvasRenderingContext2D;
    let graphCanvas: HTMLCanvasElement;
    let graphCtx: CanvasRenderingContext2D;

    let isRunning = false;
    let isCalibrating = false;

    interface Point { ts: number; x: number; y: number; quad: string }
    const history: Point[] = [];

    const targetKeys = Object.keys(SCREEN_TARGETS);
    let calibIdx = 0;
    const calibSamples: { features: number[]; target: { u: number; v: number } }[] = [];

    document.addEventListener('DOMContentLoaded', async () => {
      video = document.getElementById('webcamVideo') as HTMLVideoElement;
      webcamCanvas = document.getElementById('webcamCanvas') as HTMLCanvasElement;
      webcamCtx = webcamCanvas.getContext('2d')!;
      graphCanvas = document.getElementById('graphCanvas') as HTMLCanvasElement;
      graphCtx = graphCanvas.getContext('2d')!;

      const btnStart = document.getElementById('btnStart') as HTMLButtonElement;
      const btnCalibrate = document.getElementById('btnCalibrate') as HTMLButtonElement;
      const btnSaveXml = document.getElementById('btnSaveXml') as HTMLButtonElement;

      btnStart.onclick = toggleWebcam;
      btnCalibrate.onclick = startCalibration;
      btnSaveXml.onclick = saveXml;

      engine = new GazeTrackerEngine();
      await engine.init();
    });

    async function toggleWebcam() {
      const btnStart = document.getElementById('btnStart') as HTMLButtonElement;
      const btnCalibrate = document.getElementById('btnCalibrate') as HTMLButtonElement;
      const btnSaveXml = document.getElementById('btnSaveXml') as HTMLButtonElement;
      const mStatus = document.getElementById('mStatus')!;

      if (isRunning) {
        isRunning = false;
        btnStart.textContent = 'Start';
        btnCalibrate.disabled = true;
        mStatus.textContent = 'Stopped';
        mStatus.className = 'text-warning font-bold';
        if (video.srcObject) {
          (video.srcObject as MediaStream).getTracks().forEach(t => t.stop());
        }
        return;
      }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } }
        });
        video.srcObject = stream;
        await video.play();
        isRunning = true;
        btnStart.textContent = 'Stop';
        btnCalibrate.disabled = false;
        btnSaveXml.disabled = false;
        mStatus.textContent = 'Active (Uncalibrated)';
        mStatus.className = 'text-info font-bold';
        requestAnimationFrame(loop);
      } catch (e) {
        console.error(e);
        mStatus.textContent = 'Camera Error';
        mStatus.className = 'text-error font-bold';
      }
    }

    function loop(ts: number) {
      if (!isRunning || !engine || !video) return;

      webcamCanvas.width = video.videoWidth || 640;
      webcamCanvas.height = video.videoHeight || 480;

      webcamCtx.clearRect(0, 0, webcamCanvas.width, webcamCanvas.height);
      webcamCtx.drawImage(video, 0, 0, webcamCanvas.width, webcamCanvas.height);

      const results = engine.detect(video, ts);
      if (results && results.faceLandmarks && results.faceLandmarks[0]) {
        const landmarks = results.faceLandmarks[0];
        const extracted = engine.extractFeatures(landmarks);

        if (extracted) {
          const gaze = engine.predict(extracted.features, window.innerWidth, window.innerHeight);
          if (gaze) {
            const xPct = Math.round(gaze.u * 100);
            const yPct = Math.round(gaze.v * 100);
            document.getElementById('mGaze')!.textContent = `${xPct}%, ${yPct}%`;

            let quad = 'Center';
            if (xPct < 45 && yPct < 45) quad = 'Top-Left';
            else if (xPct > 55 && yPct < 45) quad = 'Top-Right';
            else if (xPct < 45 && yPct > 55) quad = 'Bottom-Left';
            else if (xPct > 55 && yPct > 55) quad = 'Bottom-Right';
            document.getElementById('mQuad')!.textContent = quad;

            // DRAW PLAIN RED DOT ON IRISES
            [468, 473].forEach(idx => {
              if (landmarks[idx]) {
                const ix = landmarks[idx].x * webcamCanvas.width;
                const iy = landmarks[idx].y * webcamCanvas.height;

                webcamCtx.beginPath();
                webcamCtx.arc(ix, iy, 4, 0, Math.PI * 2);
                webcamCtx.fillStyle = '#ff0000';
                webcamCtx.fill();
              }
            });

            history.push({ ts: performance.now(), x: gaze.u * 100, y: gaze.v * 100, quad });
            if (history.length > 300) history.shift();

            if (isCalibrating) {
              const currentKey = targetKeys[calibIdx];
              const target = SCREEN_TARGETS[currentKey];
              if (target) calibSamples.push({ features: extracted.features, target });
            }
          }
        }
      }

      drawGraph();
      requestAnimationFrame(loop);
    }

    function drawGraph() {
      const w = graphCanvas.width = graphCanvas.clientWidth;
      const h = graphCanvas.height = graphCanvas.clientHeight;
      graphCtx.clearRect(0, 0, w, h);

      // Grid
      graphCtx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
      graphCtx.lineWidth = 1;
      for (let i = 0; i <= 4; i++) {
        const y = (h / 4) * i;
        graphCtx.beginPath(); graphCtx.moveTo(0, y); graphCtx.lineTo(w, y); graphCtx.stroke();
      }

      if (history.length > 1) {
        const step = w / (history.length - 1);

        // Gaze X (Cyan line)
        graphCtx.beginPath();
        graphCtx.strokeStyle = '#00ffff';
        graphCtx.lineWidth = 2;
        history.forEach((p, i) => {
          const x = i * step;
          const y = h - (p.x / 100) * h;
          if (i === 0) graphCtx.moveTo(x, y); else graphCtx.lineTo(x, y);
        });
        graphCtx.stroke();

        // Gaze Y (Magenta line)
        graphCtx.beginPath();
        graphCtx.strokeStyle = '#ff00ff';
        graphCtx.lineWidth = 2;
        history.forEach((p, i) => {
          const x = i * step;
          const y = h - (p.y / 100) * h;
          if (i === 0) graphCtx.moveTo(x, y); else graphCtx.lineTo(x, y);
        });
        graphCtx.stroke();
      }
    }

    function startCalibration() {
      if (!isRunning) return;
      isCalibrating = true;
      calibIdx = 0;
      calibSamples.length = 0;
      document.getElementById('calibOverlay')!.classList.remove('hidden');
      nextCalibPoint();
    }

    function nextCalibPoint() {
      if (calibIdx >= targetKeys.length) {
        isCalibrating = false;
        document.getElementById('calibOverlay')!.classList.add('hidden');

        const mStatus = document.getElementById('mStatus')!;
        if (engine && engine.trainModel(calibSamples)) {
          mStatus.textContent = 'Calibrated ✓';
          mStatus.className = 'text-success font-bold';
        } else {
          mStatus.textContent = 'Calibration Failed';
          mStatus.className = 'text-error font-bold';
        }
        return;
      }

      const key = targetKeys[calibIdx];
      const target = SCREEN_TARGETS[key];
      const pt = document.getElementById('targetPoint')!;
      const txt = document.getElementById('calibText')!;

      pt.style.left = `${target.u * 100}%`;
      pt.style.top = `${target.v * 100}%`;
      txt.textContent = `Look at dot (${calibIdx + 1}/9: ${target.label})`;

      setTimeout(() => {
        calibIdx++;
        nextCalibPoint();
      }, 2000);
    }

    function saveXml() {
      if (history.length === 0) return;

      let xml = `<?xml version="1.0" encoding="UTF-8"?>\n<gazeData timestamp="${new Date().toISOString()}">\n  <samples>\n`;
      history.forEach((p, i) => {
        xml += `    <sample index="${i + 1}" time="${p.ts.toFixed(1)}" x="${p.x.toFixed(2)}" y="${p.y.toFixed(2)}" quadrant="${p.quad}" />\n`;
      });
      xml += `  </samples>\n</gazeData>`;

      const blob = new Blob([xml], { type: 'application/xml' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `gaze_data_${Date.now()}.xml`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</CustomHead>
